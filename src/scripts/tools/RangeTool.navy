// Navy ~ 0.2-lite
// <ds>Time & value measurement tool [Shift+Click]</ds>

[OVERLAY name=RangeTool, ctx=Canvas, verion=1.1.0, author=GPT4]

prop('colorUp', { type: 'color', def: '#3355ff' })
prop('colorDown', { type: 'color', def: '#ff3333' })
prop('fillOpacity', { type: 'number', def: 0.2 })
prop('labelOpacity', { type: 'number', def: 0.85 })

let pin1 = null
let pin2 = null
let shift = false
let state = 'idle'

draw(ctx) {
    if (!pin1 || !pin2) return

    let bounds = normalizePins()
    let color = pin2.v >= pin1.v ? $props.colorUp : $props.colorDown
    let text1 = `${formatNumber(priceDelta())} (${formatNumber(percent())}%)`
    let text2 = `${bars()} bars, ${timeText()}`

    drawRect(ctx, bounds, color)
    drawLabel(ctx, bounds, [text1, text2], color)
}

startMeasure(event) {
    pin1 = pinFromEvent(event)
    pin2 = { ...pin1 }
    state = 'drawing'
    event.preventDefault()
    $events.emitSpec('chart', 'update-layout')
}

updateMeasure(event) {
    pin2 = pinFromEvent(event)
    $events.emitSpec('chart', 'update-layout')
}

finishMeasure(event) {
    updateMeasure(event)
    state = 'finished'
    event.preventDefault()
    $events.emitSpec('chart', 'update-layout')
}

clearMeasure(event) {
    pin1 = null
    pin2 = null
    state = 'idle'
    if (event) event.preventDefault()
    $events.emitSpec('chart', 'update-layout')
}

pinFromEvent(event) {
    let layout = $core.layout
    let ti = $core.cursor.ti
    if (ti === undefined || ti === null) {
        ti = layout.x2ti(event.layerX)
    }

    let t = $core.cursor.time
    let i = nearestMainIndex(ti, t)
    let bar = mainBar(i)

    if (bar) t = bar[0]
    if (t === undefined || t === null) t = ti

    return {
        t: t,
        i: i,
        v: layout.y2value(event.layerY)
    }
}

nearestMainIndex(ti, t) {
    let main = $core.hub.mainOv
    let data = (main || {}).data || []
    if (!data.length) return 0

    if ($core.layout.indexBased) {
        let off = main.indexOffset ?? 0
        let i = Math.round(ti - off)
        return clamp(i, 0, data.length - 1)
    }

    let nearest = $lib.Utils.nearestTs(t ?? ti, data)
    return clamp(nearest[0], 0, data.length - 1)
}

mainBar(i) {
    let main = $core.hub.mainOv
    let data = (main || {}).data || []
    return data[i]
}

normalizePins() {
    let x1 = pinX(pin1)
    let x2 = pinX(pin2)
    let y1 = $core.layout.value2y(pin1.v)
    let y2 = $core.layout.value2y(pin2.v)

    return {
        x1: x1,
        x2: x2,
        y1: y1,
        y2: y2,
        left: Math.min(x1, x2),
        right: Math.max(x1, x2),
        top: Math.min(y1, y2),
        bottom: Math.max(y1, y2)
    }
}

pinX(pin) {
    let layout = $core.layout
    if (layout.indexBased) {
        return layout.ti2x(pin.t, pin.i)
    }
    return layout.time2x(pin.t)
}

drawRect(ctx, bounds, color) {
    ctx.fillStyle = $lib.Utils.applyOpacity(color, $props.fillOpacity)
    ctx.fillRect(
        bounds.left,
        bounds.top,
        bounds.right - bounds.left,
        bounds.bottom - bounds.top
    )

    let midX = (bounds.left + bounds.right) / 2
    let midY = (bounds.top + bounds.bottom) / 2
    $lib.drawArrow(ctx, midX, bounds.bottom, midX, bounds.top, color, bounds.bottom - bounds.top > 42)
    $lib.drawArrow(ctx, bounds.left, midY, bounds.right, midY, color, bounds.right - bounds.left > 42)
}

drawLabel(ctx, bounds, lines, color) {
    let paddingX = 10
    let paddingY = 8
    let lineH = 18

    ctx.font = $lib.rescaleFont($core.props.config.FONT, 14)

    let textWidth = 0
    for (var line of lines) {
        textWidth = Math.max(textWidth, ctx.measureText(line).width)
    }

    let w = textWidth + paddingX * 2
    let h = lines.length * lineH + paddingY * 2
    let x = (bounds.left + bounds.right) / 2 - w / 2
    let y = pin2.v >= pin1.v ? bounds.top - h - 10 : bounds.bottom + 10

    x = clamp(x, 4, $core.layout.width - w - 4)
    y = clamp(y, 4, $core.layout.height - h - 4)

    ctx.fillStyle = $lib.Utils.applyOpacity(color, $props.labelOpacity)
    $lib.roundRect(ctx, x, y, w, h, 5)

    ctx.fillStyle = '#ffffff'
    ctx.textAlign = 'center'
    ctx.textBaseline = 'middle'

    for (var i = 0; i < lines.length; i++) {
        ctx.fillText(lines[i], x + w / 2, y + paddingY + lineH * i + lineH / 2)
    }
}

priceDelta() {
    if (!pin1 || !pin2) return 0
    return Math.max(pin1.v, pin2.v) - Math.min(pin1.v, pin2.v)
}

percent() {
    if (!pin1 || !pin2) return 0
    let low = Math.min(pin1.v, pin2.v)
    if (!low) return 0
    return (priceDelta() / low) * 100
}

bars() {
    if (!pin1 || !pin2) return 0
    let main = $core.hub.mainOv
    let data = (main || {}).data || []
    if (!data.length) return 0

    if ($core.layout.indexBased) {
        return Math.abs(pin2.i - pin1.i) + 1
    }

    let t1 = Math.min(pin1.t, pin2.t)
    let t2 = Math.max(pin1.t, pin2.t)
    let count = 0

    for (var bar of data) {
        if (bar[0] >= t1 && bar[0] <= t2) count++
    }

    return count
}

deltaTime() {
    if (!pin1 || !pin2) return 0

    let b1 = mainBar(pin1.i)
    let b2 = mainBar(pin2.i)
    if (b1 && b2) return Math.abs(b2[0] - b1[0])

    if ($core.layout.indexBased) {
        return Math.abs(pin2.i - pin1.i) * $core.props.timeFrame
    }

    return Math.abs(pin2.t - pin1.t)
}

timeText() {
    let deltaTimeMs = deltaTime()
    let timeFrameMs = $core.props.timeFrame

    let seconds = Math.floor((deltaTimeMs / 1000) % 60)
    let minutes = Math.floor((deltaTimeMs / (1000 * 60)) % 60)
    let hours = Math.floor((deltaTimeMs / (1000 * 60 * 60)) % 24)
    let days = Math.floor(deltaTimeMs / (1000 * 60 * 60 * 24))

    let result = ''
    if (days > 0) result += days + 'd '
    if (hours > 0 || days > 0) result += hours + 'h '
    if (timeFrameMs < 60 * 60 * 1000 && minutes > 0) result += minutes + 'm '
    if (deltaTimeMs < 60 * 1000 && seconds > 0) result += seconds + 's'

    result = result.trim()
    return result || '0m'
}

formatNumber(value) {
    let x = Math.abs(value)
    if (x >= 1000) return value.toFixed(2)
    if (x >= 1) return value.toFixed(4)
    if (x >= 0.0001) return value.toFixed(6)
    return value.toFixed(8)
}

clamp(x, min, max) {
    if (max < min) return min
    return Math.max(min, Math.min(max, x))
}

keydown(event) {
    if (event.key === 'Shift') {
        shift = true
    }
}

keyup(event) {
    if (event.key === 'Shift') {
        shift = false
    }
}

mousedown(event) {
    if (state === 'idle' && (shift || event.shiftKey)) {
        startMeasure(event)
    } else if (state === 'drawing') {
        finishMeasure(event)
    } else if (state === 'finished') {
        clearMeasure(event)
    }
}

mousemove(event) {
    if (state === 'drawing') {
        updateMeasure(event)
    }
}

legend() => null
